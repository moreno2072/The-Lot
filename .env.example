# Copy this file to .env and fill in the values.

# SQLite for local dev — no setup needed. For production, use a Postgres URL
# and change the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Any long random string. Used to sign session cookies.
JWT_SECRET="change-this-to-a-long-random-string"

# Optional — enables real checkout. Get a free test key at
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
